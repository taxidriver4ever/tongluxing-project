<view class="page-shell invite-page">
  <td-topbar title="邀请好友" />
  <scroll-view scroll-y class="page-content">
    <view wx:if="{{loading}}" class="state card">正在生成邀请二维码…</view>
    <view wx:elif="{{error}}" class="state card"><text>{{error}}</text><view class="retry" bindtap="load">重新加载</view></view>
    <block wx:elif="{{code && qr && summary}}">
      <view class="hero">
        <view class="hero-title">邀请好友一起出发</view>
        <view class="hero-copy">好友完成注册后，你将获得成长值</view>
        <view class="qr-box"><image src="{{qrImage}}" mode="aspectFit" /></view>
        <view class="code" bindtap="copyCode">邀请码　{{code.inviteCode}}</view>
        <view class="expire">有效至 {{expiresText}} · 每 7 天自动更换</view>
      </view>

      <view class="metrics card">
        <view><text>{{summary.validInviteCount || 0}}</text><label>有效邀请</label></view>
        <view><text>{{summary.nextRewardNeed || 0}}</text><label>下一档还差</label></view>
        <view><text>{{summary.grantedRuleCodes.length}}</text><label>已获规则</label></view>
      </view>

      <view class="actions">
        <view class="primary" bindtap="saveQr"><image src="/assets/icons/download.svg" />保存二维码</view>
        <view class="secondary" bindtap="copyLink"><image src="/assets/icons/copy.svg" />复制邀请链接</view>
      </view>

      <view class="guide card">
        <view class="guide-title"><image src="/assets/icons/info.svg" />邀请奖励使用教程</view>
        <view class="step"><view class="num">1</view><view><text>保存邀请二维码</text><label>点击上方按钮，图片会真实保存到手机相册。</label></view></view>
        <view class="step"><view class="num">2</view><view><text>把二维码发给好友</text><label>好友可以从相册选择二维码，也可以直接扫码识别。</label></view></view>
        <view class="step"><view class="num">3</view><view><text>好友完成注册并设置密码</text><label>首次注册必须设置密码，随后可以绑定你的邀请码。</label></view></view>
        <view class="step"><view class="num">4</view><view><text>系统自动绑定并发放奖励</text><label>邀请码验签成功后自动绑定，无需上传截图审核。</label></view></view>
      </view>

      <view class="validate" bindtap="validate">验证当前二维码是否有效</view>
      <button class="share" open-type="share">分享给微信好友</button>
      <view class="safe-tip">二维码带有服务端签名，过期、被篡改或已停用时会被拒绝。</view>
    </block>
  </scroll-view>
</view>
