<view class="auth-page"><view class="back" bindtap="goBack"><image src="/assets/icons/chevron-left.svg" /></view><view class="status-space"></view><view class="page-content"><view class="brand">同路行</view><view class="form-card"><view class="title">绑定你的密码</view><view class="desc">首次微信登录，请设置密码。之后可使用密码登录其他端。</view><view class="label">设置密码</view><input class="field" password placeholder="请输入密码" value="{{password}}" bindinput="passwordInput" /><view class="label">确认密码</view><input class="field" password placeholder="请再次输入密码" value="{{confirm}}" bindinput="confirmInput" /><view class="action" bindtap="submit">完成绑定</view></view></view></view>
