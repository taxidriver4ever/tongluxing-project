<view class="page-shell"><td-topbar title="好友申请"/><view class="page-content"><view wx:for="{{requests}}" wx:key="id" class="request card"><view class="avatar">{{item.avatar}}</view><view class="main"><view class="name">{{item.name}}</view><view class="note">{{item.note}}</view></view><view wx:if="{{item.accepted}}" class="accepted">已添加</view><view wx:else class="accept" data-id="{{item.id}}" bindtap="accept">接受</view></view><view wx:if="{{requests.length === 0}}" class="empty-state">暂无新的好友申请</view></view></view>
