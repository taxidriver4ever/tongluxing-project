<view class="page-shell">
  <td-topbar title="行程" placeholder="搜索路线、车队、目的地" action="加" />

  <scroll-view scroll-y class="page-content">
    <view wx:if="{{currentTrip}}" class="state-card card" data-id="{{currentTrip.tripId}}" bindtap="goDetail">
      <view class="state-title">
        <text>当前行程：{{currentTrip.startName}} → {{currentTrip.endName}}</text>
        <text class="running">{{currentTrip.status === 'ONGOING' ? '进行中' : '已发布'}}</text>
      </view>
      <view class="sub">出发：{{currentTrip.departureTime}} ｜ 预计 {{currentTrip.estimatedDays || 1}} 天 ｜ 同路深度：{{currentTrip.travelDepth === 'LIGHT' ? '浅' : currentTrip.travelDepth === 'DEEP' ? '深' : '中'}}</view>
      <view class="btn-row">
        <view class="btn ghost" catchtap="goEdit">编辑行程</view>
        <view class="btn" catchtap="goCreateTeam">创建车队</view>
        <view class="btn gray" catchtap="onEndTrip">结束行程</view>
      </view>
    </view>

    <view wx:else class="state-card card empty-trip">
      <view class="state-title">
        <text>还没有当前行程</text>
        <text class="running">待发布</text>
      </view>
      <view class="sub">发布行程后，可查看路线、成员快照和公开行程推荐。</view>
      <view class="btn-row">
        <view class="btn" bindtap="goPublish">发布行程</view>
        <view class="btn ghost" bindtap="goHistory">历史行程</view>
      </view>
    </view>

    <view class="groupbuy-tip card" bindtap="goGroupbuyList">
      <view>
        <view class="tip-title">沿途拼团 4</view>
        <view class="tip-sub">服务区餐饮、露营补给、民宿车队房正在拼</view>
      </view>
      <view class="pill orange">增强版</view>
    </view>

    <view class="section-head">
      <text>公开行程</text>
      <text class="more" bindtap="goPublicList">查看更多</text>
    </view>

    <view wx:for="{{publicTrips}}" wx:key="tripId" class="convoy-card card" data-id="{{item.tripId}}" bindtap="goDetail">
      <view class="convoy-top">
        <view class="convoy-name">
          <td-avatar text="行" theme="blue" />
          <view class="convoy-copy">
            <text class="name">{{item.startName}} → {{item.endName}}</text>
            <text class="desc">{{item.departureTime}} · {{item.joinedVehicleCount}}/{{item.maxVehicleCount}}车</text>
          </view>
        </view>
        <view class="match">{{item.publicFlag ? '公开' : '私密'}}</view>
      </view>
      <view class="route-line">
        <text>{{item.routeSummary || item.startName}}</text>
        <text>{{item.remark || '暂无备注'}}</text>
      </view>
      <view class="tags">
        <td-tag text="{{item.travelDepth === 'LIGHT' ? '浅度同行' : item.travelDepth === 'DEEP' ? '深度同行' : '中度同行'}}" />
        <td-tag text="{{item.status === 'ONGOING' ? '进行中' : '可查看'}}" />
      </view>
    </view>

    <view wx:if="{{publicTrips.length === 0}}" class="notice-card card">
      暂无公开行程，发布公开行程后会出现在这里。
    </view>

    <view class="section-head">
      <text>顺路车队</text>
      <text class="more" bindtap="goNearbyTeams">附近车队</text>
    </view>

    <view wx:for="{{recommendedTeams}}" wx:key="teamId" class="convoy-card card">
      <view class="convoy-top">
        <view class="convoy-name" data-id="{{item.teamId}}" bindtap="goTeamDetail">
          <td-avatar text="队" theme="blue" />
          <view class="convoy-copy">
            <text class="name">{{item.teamName}}</text>
            <text class="desc">{{item.currentMemberCount}}/{{item.maxMemberCount}}车 · {{item.departureTime}}</text>
          </view>
        </view>
        <view class="match">{{item.overlapRate}}%</view>
      </view>
      <view class="route-line">
        <text>{{item.startName}} → {{item.endName}}</text>
        <text>顺路率越高，越适合申请入队</text>
      </view>
      <view class="btn-row">
        <view class="btn gray" data-id="{{item.teamId}}" bindtap="goTeamDetail">打招呼</view>
        <view class="btn" data-id="{{item.teamId}}" bindtap="applyTeam">申请入队</view>
      </view>
    </view>

    <view wx:if="{{recommendedTeams.length === 0}}" class="notice-card card">
      附近暂无顺路车队。
    </view>
  </scroll-view>

  <td-tabbar active="trip" />
</view>
