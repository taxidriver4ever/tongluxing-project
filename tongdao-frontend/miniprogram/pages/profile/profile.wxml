<view class="page-shell user-profile-page">
  <view class="profile-head" style="{{headStyle}}">
    <view class="profile-head-top">
      <view class="head-title">我的</view>
      <view class="head-actions">
        <view wx:if="{{!loading}}" class="refresh-btn" bindtap="loadProfile">刷新</view>
      </view>
    </view>

    <view class="profile-row">
      <view class="profile-avatar">{{avatarText}}</view>
      <view class="profile-copy">
        <view class="profile-name">{{profile.nickname || "同道车友"}}</view>
        <view class="profile-sub">{{profile.cityName || "未设置城市"}} · 资料完整度 {{profile.profileCompletion || 0}}%</view>
        <view class="tag-row">
          <view class="status-pill {{identityStatus === 'APPROVED' ? 'green' : identityStatus === 'PENDING' ? 'orange' : identityStatus === 'REJECTED' ? 'red' : ''}}">
            {{identityStatus === 'APPROVED' ? '已实名' : identityStatus === 'PENDING' ? '审核中' : identityStatus === 'REJECTED' ? '实名被拒' : '未实名'}}
          </view>
          <view class="status-pill">车辆待认证</view>
        </view>
      </view>
    </view>

    <view class="stats">
      <view class="stat">
        <text class="stat-value">{{profile.profileCompletion || 0}}%</text>
        <text class="stat-label">资料完整度</text>
      </view>
      <view class="stat">
        <text class="stat-value">2</text>
        <text class="stat-label">参与拼团</text>
      </view>
      <view class="stat">
        <text class="stat-value">1</text>
        <text class="stat-label">待核销</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!profile.userId}}" class="login-tip card">
    <view>
      <view class="login-title">当前未获取到用户资料</view>
      <view class="login-sub">登录后可查看订单、核销码和个人资料</view>
    </view>
    <view class="btn" bindtap="goLogin">去登录</view>
  </view>

  <view wx:if="{{rejectReason}}" class="notice reject">
    <view class="notice-title">实名审核未通过</view>
    <view>{{rejectReason}}</view>
  </view>

  <view class="trade-panel card">
    <view class="panel-title">我的交易</view>
    <view class="trade-grid">
      <view class="trade-item" bindtap="goGroupbuy">
        <text class="trade-num">2</text>
        <text class="trade-label">我的拼团</text>
      </view>
      <view class="trade-item" bindtap="goVerification">
        <text class="trade-num">1</text>
        <text class="trade-label">待核销</text>
      </view>
      <view class="trade-item" data-label="退款" bindtap="showTradeTip">
        <text class="trade-num">0</text>
        <text class="trade-label">退款中</text>
      </view>
      <view class="trade-item" data-label="订单" bindtap="showTradeTip">
        <text class="trade-num">0</text>
        <text class="trade-label">已完成</text>
      </view>
    </view>
  </view>

  <view class="menu-card card">
    <view wx:for="{{menus}}" wx:key="label" class="menu-row user-menu" data-url="{{item.url}}" bindtap="onMenuTap">
      <text>{{item.label}}</text>
      <text>{{item.value}}</text>
    </view>
  </view>

  <view class="notice">
    <view class="notice-title">隐私提示</view>
    <view>公开资料会被行程、车队、推荐列表引用。</view>
    <view>手机号默认不公开，仅认证和安全场景使用。</view>
  </view>

  <td-tabbar active="profile" />
</view>
