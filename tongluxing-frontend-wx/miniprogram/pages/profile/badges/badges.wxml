<view class="badges-page"><view class="back" bindtap="back"><image src="/assets/icons/chevron-left.svg"/></view><scroll-view scroll-y class="page"><view class="header">我的勋章</view><view class="badge-card"><view class="title">我的勋章</view><view class="grid"><block wx:for="{{badges}}" wx:key="code"><view wx:if="{{item.earned}}" class="badge"><view class="icon"><image style="width:48rpx;height:48rpx" src="/assets/icons/award.svg"/></view><view class="name">{{item.name}}</view><view class="desc">{{item.desc}}</view></view></block></view></view><view class="badge-card"><view class="title">未解锁勋章</view><view class="grid"><block wx:for="{{badges}}" wx:key="code"><view wx:if="{{!item.earned}}" class="badge lock"><view class="icon"><image style="width:48rpx;height:48rpx" src="/assets/icons/lock.svg"/></view><view class="name">{{item.name}}</view><view class="condition">解锁条件：<view>{{item.desc}}</view></view></view></block></view></view><view class="page-spacer" style="height:80rpx"></view></scroll-view></view>
