<view class="invite-page"><view class="header"><view class="back" bindtap="back"><image src="/assets/icons/chevron-left.svg"/></view><view class="header-title">邀请好友</view><view></view></view><scroll-view scroll-y class="page"><view class="hero"><view class="road"><view class="tree left"></view><view class="tree right"></view><view class="car-body"><view class="person p1">林</view><view class="person p2">陈</view><view class="person p3">周</view></view></view></view><view class="intro">邀请同行伙伴加入同路行，<view>一起出发，分享每一段自驾旅程。</view><view class="invite-code" bindtap="copy">我的邀请码 <text>TLX2026</text></view></view><view class="wave"></view><view class="summary"><view class="summary-item"><view class="summary-value">12</view><view class="summary-label">累计邀请好友</view></view><view class="summary-item"><view class="summary-value">600</view><view class="summary-label">已获得成长值</view></view><view class="reward"><text>好友注册 <text class="reward-value">+50</text></text><text>完成首次行程 <text class="reward-value">+100</text></text></view></view><view class="section-title">已邀请好友</view><view class="invite-list"><view wx:for="{{friends}}" wx:key="name" class="invite-row"><view class="avatar">{{item.avatar}}</view><view class="person-info"><view class="person-name">{{item.name}}</view><view class="person-date">{{item.date}}</view></view><view class="state {{item.joined ? 'joined' : ''}}">{{item.joined ? '已加入' : '3 天后失效'}}<view wx:if="{{!item.joined}}">发送提醒</view></view></view></view><button class="btn" open-type="share">生成邀请二维码</button></scroll-view></view>
