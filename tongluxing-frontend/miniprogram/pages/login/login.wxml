<view class="login-page">
  <view class="login-home" style="{{homeStyle}}" bindtap="goHome">首页</view>

  <view class="login-bg">
    <view class="road r1"></view>
    <view class="road r2"></view>
    <view class="road r3"></view>
  </view>

  <view class="login-content" style="{{contentStyle}}">
    <view class="brand">
      <view class="logo">同</view>
      <view>
        <view class="brand-title">同路行</view>
        <view class="brand-sub">自驾路上，找到同路人</view>
      </view>
    </view>

    <view class="slogan">
      <text>微信手机号一键登录</text>
      <text>连接每一段同路。</text>
    </view>
    <view class="desc">首次登录将自动创建账号，后续完成车辆认证即可使用组队能力。</view>

    <view class="form-card">
      <button
        wx:if="{{agreed}}"
        class="button wx-login-btn {{loading ? 'disabled' : ''}}"
        open-type="getPhoneNumber"
        bindgetphonenumber="onWxPhoneLogin"
        loading="{{loading}}"
        disabled="{{loading}}"
        style="width: 100%; min-width: 100%; max-width: none; margin-left: 0; margin-right: 0;"
      >
        微信手机号一键登录
      </button>
      <button
        wx:else
        class="button wx-login-btn pending"
        bindtap="onNeedAgree"
        style="width: 100%; min-width: 100%; max-width: none; margin-left: 0; margin-right: 0;"
      >
        微信手机号一键登录
      </button>

      <view class="agree" bindtap="toggleAgree">
        <view class="check {{agreed ? '' : 'off'}}"></view>
        <view>我已阅读并同意 <text class="link">用户协议</text> 和 <text class="link">隐私政策</text></view>
      </view>
    </view>

    <view class="bottom-note">首次登录将自动创建账号</view>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <view class="spinner"></view>
    <view>正在同步登录状态...</view>
  </view>

  <view wx:if="{{showAgreementModal}}" class="modal-mask">
    <view class="modal">
      <view class="modal-title">请先同意协议</view>
      <view class="modal-text">登录代表你将使用同路行的行程、组队、位置等能力。继续前请阅读并同意用户协议和隐私政策。</view>
      <view class="modal-actions">
        <view class="modal-btn" bindtap="closeAgreementModal">暂不登录</view>
        <view class="modal-btn primary" bindtap="agreeAndContinue">同意并继续</view>
      </view>
    </view>
  </view>
</view>
