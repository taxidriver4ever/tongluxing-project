<view class="chat-page">
  <view class="header" style="padding-top:{{contentTop}}px"><view class="back" bindtap="back"><image src="/assets/icons/chevron-left.svg"/></view><view class="head-avatar">{{conversation ? conversation.conversationName.slice(0,2) : '同行'}}</view><view class="head-info"><view class="head-name">{{conversation ? conversation.conversationName : '行程群聊'}}</view><view class="head-sub">{{conversation && conversation.conversationStatus === 'ACTIVE' ? '群聊进行中' : '行程成员沟通'}}</view></view><view class="more" bindtap="detail"><image src="/assets/icons/ellipsis.svg"/></view></view>
  <scroll-view scroll-y class="chat" scroll-into-view="{{bottomAnchor}}" style="top:{{contentTop + 70}}px"><view wx:if="{{loading}}" class="system">正在加载聊天记录…</view><view wx:elif="{{!messages.length}}" class="system">群聊已创建，和同行成员打个招呼吧</view><view wx:for="{{messages}}" wx:key="messageId" class="message {{item.mine ? 'mine' : ''}}"><view wx:if="{{!item.mine}}" class="user-avatar">{{item.avatarText}}</view><view class="message-main"><view wx:if="{{!item.mine}}" class="sender">{{item.senderNickname}}</view><view class="bubble">{{item.content}}</view><view class="message-time">{{item.timeText}}</view></view></view><view id="{{bottomAnchor}}"></view></scroll-view>
  <view class="composer"><input class="box" placeholder="输入消息..." value="{{draft}}" bindinput="input" confirm-type="send" bindconfirm="send"/><view class="send {{sending ? 'disabled' : ''}}" bindtap="send"><image src="/assets/icons/send.svg"/></view></view>
</view>
