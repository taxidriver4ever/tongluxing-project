<view class="badges-page"><view class="back" bindtap="back"><image src="/assets/icons/chevron-left.svg"/></view><scroll-view scroll-y class="page"><view class="header">我的勋章</view><view wx:if="{{loading}}" class="empty-state">正在加载勋章墙…</view><block wx:else><view class="badge-card"><view class="title">已获得 · {{earned.length}}</view><view wx:if="{{earned.length}}" class="grid"><view wx:for="{{earned}}" wx:key="badgeCode" class="badge"><view class="icon"><image src="/assets/icons/award.svg"/></view><view class="name">{{item.badgeName}}</view><view class="desc">{{item.conditionDescription}}</view></view></view><view wx:else class="empty-small">完成行程后即可解锁首枚勋章</view></view><view class="badge-card"><view class="title">未解锁 · {{locked.length}}</view><view class="grid"><view wx:for="{{locked}}" wx:key="badgeCode" class="badge lock"><view class="icon"><image src="/assets/icons/lock.svg"/></view><view class="name">{{item.badgeName}}</view><view class="condition">{{item.currentValue}} / {{item.threshold}}<view>{{item.conditionDescription}}</view></view></view></view></view></block><view class="page-spacer"></view></scroll-view></view>
