<view class="auth-page">
  <view class="page-content">
    <view class="brand">同路行</view>
    <view class="form-card">
      <view class="title">设置登录密码</view>
      <view class="desc">首次微信注册必须设置密码，之后可使用同一账号登录 App。</view>
      <view class="label">设置密码</view>
      <input class="field" password maxlength="32" placeholder="请输入6-32位密码" value="{{password}}" bindinput="passwordInput" />
      <view class="label second">确认密码</view>
      <input class="field" password maxlength="32" placeholder="请再次输入密码" value="{{confirm}}" bindinput="confirmInput" confirm-type="done" bindconfirm="submit" />
      <button class="action" loading="{{loading}}" disabled="{{loading}}" bindtap="submit">完成设置</button>
      <view class="mandatory">此步骤为必填，未完成时下次仍会回到这里</view>
    </view>
  </view>
</view>
