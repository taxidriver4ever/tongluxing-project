<view class="page-shell emergency-page">
  <td-topbar title="紧急联系人" placeholder="预留家人或朋友联系方式" action="急" />
  <scroll-view scroll-y class="page-content">
    <view class="card form-card">
      <view class="field">
        <view class="label">联系人姓名</view>
        <input class="input" value="{{form.contactName}}" data-field="contactName" bindinput="onInput" maxlength="64" placeholder="例如：张女士" />
      </view>
      <view class="field">
        <view class="label">关系</view>
        <input class="input" value="{{form.relation}}" data-field="relation" bindinput="onInput" maxlength="32" placeholder="家人 / 朋友 / 同事" />
      </view>
      <view class="field">
        <view class="label">手机号</view>
        <input class="input" type="number" value="{{form.phone}}" data-field="phone" bindinput="onInput" maxlength="11" placeholder="请输入 11 位手机号" />
      </view>
      <view class="default-row">
        <view>
          <view class="label">默认联系人</view>
          <view class="hint">SOS 场景优先通知默认联系人</view>
        </view>
        <switch checked="{{form.isDefault}}" bindchange="onDefaultChange" color="#2F7DF6" />
      </view>
      <view class="btn save-btn {{loading ? 'gray' : ''}}" bindtap="onAdd">{{loading ? '保存中...' : '新增紧急联系人'}}</view>
    </view>

    <view class="section-head">
      <text>联系人列表</text>
      <text class="more">{{contacts.length}} 人</text>
    </view>

    <view wx:if="{{contacts.length === 0}}" class="empty card">
      <view>暂无紧急联系人</view>
      <text>添加后可在 SOS、行程异常等场景快速通知。</text>
    </view>

    <view wx:for="{{contacts}}" wx:key="contactId" class="contact-card card">
      <view class="contact-avatar">{{item.contactName}}</view>
      <view class="contact-main">
        <view class="contact-name">
          <text>{{item.contactName}}</text>
          <view wx:if="{{item.isDefault}}" class="pill green">默认</view>
        </view>
        <view class="contact-meta">{{item.relation || "未填写关系"}} · {{item.phoneMask}}</view>
      </view>
      <view class="delete-btn" data-id="{{item.contactId}}" bindtap="onDelete">删除</view>
    </view>
  </scroll-view>
</view>
