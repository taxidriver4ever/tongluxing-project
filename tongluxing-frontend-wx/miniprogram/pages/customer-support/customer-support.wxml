<view class="page-shell"><td-topbar title="客服与投诉"/><view class="page-content">
  <view class="actions"><view class="action" data-type="TICKET" bindtap="submit"><image src="/assets/icons/headphones.svg"/><text>联系客服</text></view><view class="action danger" data-type="COMPLAINT" bindtap="submit"><image src="/assets/icons/shield-alert.svg"/><text>提交投诉</text></view></view>
  <view class="section-title">我的工单</view><view class="card list"><view wx:if="{{!tickets.length}}" class="empty">暂无工单</view><view wx:for="{{tickets}}" wx:key="id" class="row"><view><view class="row-title">{{item.title || '客服工单'}}</view><view class="row-sub">{{item.content}}</view><view class="row-meta">消息 {{item.messages.length}} 条 · #{{item.id}}</view></view><text>{{item.statusText}}</text></view></view>
  <view class="section-title">处理通知</view><view class="card list"><view wx:if="{{!notices.length}}" class="empty">暂无客服通知</view><view wx:for="{{notices}}" wx:key="id" class="row notice-row" data-id="{{item.id}}" data-status="{{item.readStatus}}" bindtap="readNotice"><view class="notice-dot {{item.readStatus === 'READ' ? 'read' : ''}}"></view><view><view class="row-title">{{item.title}}</view><view class="row-sub">{{item.content}}</view></view></view></view>
</view></view>
