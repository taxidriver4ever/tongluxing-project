<view class="page-shell">
  <td-topbar title="车队详情" placeholder="{{team.startName}} → {{team.endName}}" action="队" />
  <scroll-view scroll-y class="page-content">
    <view class="team-hero card">
      <view class="hero-top">
        <td-avatar text="队" theme="blue" />
        <view class="hero-copy">
          <view class="team-name">{{team.teamName || '车队'}}</view>
          <view class="team-sub">{{team.teamDesc || '队长暂未填写说明'}}</view>
        </view>
        <view class="status">{{team.teamStatus}}</view>
      </view>
      <view class="route-box">
        <view>{{team.startName}} → {{team.endName}}</view>
        <view>出发：{{team.departureTime}}</view>
      </view>
      <view class="stats">
        <view><text>{{team.currentMemberCount}}/{{team.maxMemberCount}}</text><text>车辆</text></view>
        <view><text>{{team.joinMode}}</text><text>加入方式</text></view>
        <view><text>{{team.publicFlag ? '公开' : '私密'}}</text><text>状态</text></view>
      </view>
    </view>

    <view class="section-head"><text>队员</text><text class="more">{{members.length}} 人</text></view>
    <view class="card member-card">
      <view wx:for="{{members}}" wx:key="memberId" class="member-row">
        <view class="member-left">
          <td-avatar text="{{item.memberRole === 'OWNER' ? '长' : '友'}}" theme="{{item.memberRole === 'OWNER' ? 'blue' : 'green'}}" />
          <view>
            <view class="member-name">{{item.nicknameSnapshot || '同路行车友'}}</view>
            <view class="member-sub">{{item.vehicleSnapshot || '未填写车辆'}}</view>
          </view>
        </view>
        <td-tag text="{{item.memberRole === 'OWNER' ? '队长' : '队员'}}" />
      </view>
      <view wx:if="{{members.length === 0}}" class="empty">暂无成员</view>
    </view>

    <view class="notice card">
      <view class="notice-title">队内公告</view>
      <view class="notice-text">{{team.notice || '暂无公告'}}</view>
    </view>

    <view class="action-row">
      <view class="btn gray" bindtap="goApply">申请入队</view>
      <view class="btn green" bindtap="enterChat">进入群聊</view>
      <view class="btn ghost" bindtap="onExit">退出车队</view>
    </view>
  </scroll-view>
</view>
