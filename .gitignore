# =========================
# Tongluxing project ignore rules
# Keep source code and shared config, ignore generated/local files.
# =========================

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
.factorypath
.apt_generated/
.springBeans
.sts4-cache/

# Logs and runtime dumps
*.log
/logs/
tongluxing-backend/**/logs/
*.pid
hs_err_pid*
replay_pid*

# Environment and local-only config
.env
.env.*
.env.example
application-local.yml
application-local.yaml
application-local.properties
application-*-local.yml
application-*-local.yaml
application-*-local.properties

# Java / Maven backend generated files
*.class
target/
build/
out/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

# Packaged archives and build artifacts
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Node / miniprogram frontend dependencies and caches
node_modules/
miniprogram_npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnpm-store/

# WeChat miniprogram local/developer files
project.private.config.json
private.*
.miniprogram/
.weapp/

# Generated frontend output from TypeScript / Less builds
*.js.map
*.wxss.map
tongluxing-frontend/miniprogram/**/*.js
tongluxing-frontend/miniprogram/**/*.wxss

# Test / coverage / temporary output
coverage/
.nyc_output/
tmp/
temp/
.cache/
.eslintcache

# Docker / local service data
docker-data/
/data/
*.sqlite
*.sqlite3
