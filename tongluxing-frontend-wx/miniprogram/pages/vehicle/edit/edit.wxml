<view class="page-shell"><td-topbar title="{{editing ? '编辑车辆' : '添加车辆'}}"/><view class="page-content"><view class="form card"><view class="label">车辆品牌</view><input placeholder="如：理想" value="{{brand}}" data-key="brand" bindinput="input"/><view class="label">车辆型号</view><input placeholder="如：L7 Max" value="{{model}}" data-key="model" bindinput="input"/><view class="label">车牌号码</view><input placeholder="如：川A·12345" value="{{plate}}" data-key="plate" bindinput="input"/><view class="row"><view><view class="label">车辆颜色</view><input placeholder="星环灰" value="{{color}}" data-key="color" bindinput="input"/></view><view><view class="label">座位数</view><picker range="{{seatOptions}}" bindchange="seat"><view class="picker">{{seats}}座</view></picker></view></view><view class="default"><text>设为默认车辆</text><switch checked="{{isDefault}}" bindchange="toggle" color="#3A86FF"/></view></view><view class="primary-btn save" bindtap="save">保存车辆</view></view></view>
