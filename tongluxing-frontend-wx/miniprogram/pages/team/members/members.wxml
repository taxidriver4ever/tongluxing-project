<view class="page-shell"><td-topbar title="{{title}}"/><view class="page-content"><view wx:if="{{loading}}" class="empty-state">正在加载成员…</view><block wx:else><view class="summary card"><view class="avatars"><view wx:for="{{members}}" wx:key="id" class="mini-avatar">{{item.avatar}}</view></view><view><view class="summary-title">{{title}}</view><view class="summary-sub">共 {{members.length}} 位成员</view></view></view><view class="section-title">成员列表</view><view wx:if="{{members.length}}" class="member-list card"><view wx:for="{{members}}" wx:key="id" class="member"><view class="avatar">{{item.avatar}}</view><view class="member-main"><view class="member-name">{{item.name}} <text wx:if="{{item.owner}}">队长</text></view><view class="member-car">{{item.car}}</view></view><view class="online {{item.status === 'ACTIVE' || item.status === 'JOINED' ? '' : 'off'}}"></view></view></view><view wx:else class="empty-state">暂无成员信息</view></block></view></view>
