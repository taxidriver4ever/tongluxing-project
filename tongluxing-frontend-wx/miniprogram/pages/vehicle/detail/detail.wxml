<view class="page-shell"><td-topbar title="车辆详情"/><view class="page-content"><view class="vehicle-hero card"><view class="car"><image src="/assets/icons/car-front.svg"/></view><view class="title">{{vehicle.brand}} {{vehicle.model}}</view><view class="plate">{{vehicle.plate}}</view><view class="pill success">{{vehicle.certified ? '已认证' : '待认证'}}</view></view><view class="section-title">车辆资料</view><view class="info card"><view><text>车辆颜色</text><text class="strong">{{vehicle.color}}</text></view><view><text>座位数</text><text class="strong">{{vehicle.seats}}座</text></view><view><text>默认车辆</text><text class="strong">{{vehicle.default ? '是' : '否'}}</text></view></view><view class="secondary-btn" bindtap="certify">提交车辆认证</view><view class="secondary-btn" bindtap="edit">编辑车辆</view><view class="danger">删除车辆</view></view></view>
