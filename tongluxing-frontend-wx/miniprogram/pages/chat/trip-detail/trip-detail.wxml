<view class="page-shell"><td-topbar title="群组行程"/><view class="page-content"><view wx:if="{{loading}}" class="empty-state">正在加载关联行程…</view><view wx:elif="{{trip}}" class="trip-card card"><view class="pill">{{trip.statusText}}</view><view class="title">{{trip.title || '自驾行程'}}</view><view class="date">{{trip.departureTime}}</view><view class="route"><view class="dot start"></view><text>{{trip.startLocation.name || trip.startName}}</text><view class="line"></view><view class="dot end"></view><text>{{trip.endLocation.name || trip.endName}}</text></view><view class="stats"><text>{{trip.distanceText}}</text><text>{{trip.durationText}}</text><text>{{trip.joinedVehicleCount || 1}}/{{trip.maxVehicleCount || trip.expectedPeople}}人</text></view><view class="primary-btn" bindtap="open">查看行程详情</view></view><view wx:else class="empty-state">未找到关联行程</view></view></view>
