<view class="page-shell"><td-topbar title="" placeholder="搜索地点" /><view class="page-content search-page"><view class="search-box"><image src="/assets/icons/search.svg"/><input focus placeholder="输入目的地、服务区或景点" value="{{keyword}}" bindinput="onInput"/></view><view class="section-title">当前位置</view><view class="location-card card" bindtap="choose" data-name="成都·锦江"><image src="/assets/icons/navigation.svg"/><view><view class="name">成都·锦江</view><view class="address">四川省成都市锦江区</view></view></view><view class="section-title">{{keyword ? '搜索结果' : '最近搜索'}}</view><view class="result-list card"><view wx:for="{{results}}" wx:key="name" class="result" data-name="{{item.name}}" bindtap="choose"><view class="pin"></view><view><view class="name">{{item.name}}</view><view class="address">{{item.address}}</view></view></view></view></view></view>
