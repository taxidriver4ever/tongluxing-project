<view class="page-shell"><td-topbar title="车队管理"/><view class="page-content"><view class="section-title"><text>加入申请</text><text class="section-more">{{requests.length}} 条待处理</text></view><view wx:if="{{loading}}" class="empty-state">正在加载申请…</view><view class="request card" wx:for="{{requests}}" wx:key="applicationId"><view class="avatar">{{item.nickname.slice(0,1)}}</view><view class="request-main"><view class="name">{{item.nickname || '同行用户'}}</view><view class="desc">{{item.conversationName}} · {{item.applicationMessage || '申请加入'}}</view></view><view class="actions"><view class="reject" data-id="{{item.applicationId}}" data-decision="REJECTED" bindtap="review">拒绝</view><view class="approve" data-id="{{item.applicationId}}" data-decision="APPROVED" bindtap="review">同意</view></view></view><view wx:if="{{!loading && !requests.length}}" class="empty-state">暂无待处理申请</view><view class="section-title">管理说明</view><view class="settings card"><view class="setting"><text>成员由入队申请审核后自动加入</text></view><view class="setting"><text>行程群聊与车队成员保持同步</text></view></view><view class="danger" bindtap="dismiss">解散车队</view></view></view>
