<view class="page-shell identity-page">
  <td-topbar title="实名认证" placeholder="提交真实姓名和证件信息" action="证" />
  <scroll-view scroll-y class="page-content">
    <view class="status-card card">
      <view class="status-title">当前实名状态</view>
      <view class="pill {{status === 'APPROVED' ? 'green' : status === 'PENDING' ? 'orange' : status === 'REJECTED' ? 'red' : ''}}">
        {{status === 'APPROVED' ? '已实名' : status === 'PENDING' ? '审核中' : status === 'REJECTED' ? '审核拒绝' : '未提交'}}
      </view>
      <view wx:if="{{idCardNoMask}}" class="status-sub">证件号：{{idCardNoMask}}</view>
      <view wx:if="{{rejectReason}}" class="reject-text">拒绝原因：{{rejectReason}}</view>
    </view>

    <view class="form-card card">
      <view class="field">
        <view class="label">真实姓名</view>
        <input class="input" value="{{form.realName}}" data-field="realName" bindinput="onInput" maxlength="64" placeholder="请输入真实姓名" disabled="{{status === 'PENDING' || status === 'APPROVED'}}" />
      </view>
      <view class="field">
        <view class="label">身份证号</view>
        <input class="input" value="{{form.idCardNo}}" data-field="idCardNo" bindinput="onInput" placeholder="请输入身份证号" disabled="{{status === 'PENDING' || status === 'APPROVED'}}" />
      </view>
      <view class="field">
        <view class="label">认证图片 URL</view>
        <input class="input" value="{{form.faceImageUrl}}" data-field="faceImageUrl" bindinput="onInput" placeholder="https://cdn.example.com/cert.jpg" disabled="{{status === 'PENDING' || status === 'APPROVED'}}" />
      </view>
    </view>

    <view class="notice">
      <view class="notice-title">隐私保护</view>
      <view>身份证号会加密保存，页面只展示脱敏结果。审核中不允许重复提交。</view>
    </view>

    <view wx:if="{{status !== 'PENDING' && status !== 'APPROVED'}}" class="btn submit-btn {{loading ? 'gray' : ''}}" bindtap="onSubmit">
      {{loading ? '提交中...' : '提交实名认证'}}
    </view>
  </scroll-view>
</view>
