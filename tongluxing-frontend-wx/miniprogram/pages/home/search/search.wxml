<view class="page-shell"><td-topbar title="选择地点"/><view class="page-content search-page">
  <view class="search-box"><image src="/assets/icons/search.svg"/><input focus placeholder="输入目的地、服务区或景点" value="{{keyword}}" bindinput="onInput"/></view>
  <view wx:if="{{!keyword && history.length}}" class="section-head"><text>最近搜索</text><text class="clear-text" bindtap="clearHistory">清空</text></view>
  <view wx:if="{{!keyword && history.length}}" class="result-list card"><view wx:for="{{history}}" wx:key="historyId" class="result" data-index="{{index}}" data-source="history" bindtap="choose"><image src="/assets/icons/history.svg"/><view class="result-main"><view class="name">{{item.name}}</view><view class="address">{{item.address}}</view></view><text wx:if="{{item.distanceMeters}}" class="distance">{{item.distanceMeters}}m</text></view></view>
  <view class="section-head"><text>{{keyword ? '搜索结果' : '热门地点'}}</text></view>
  <view wx:if="{{loading}}" class="empty-state">正在搜索地点…</view>
  <view wx:elif="{{results.length}}" class="result-list card"><view wx:for="{{results}}" wx:key="name" class="result" data-index="{{index}}" data-source="result" bindtap="choose"><image src="/assets/icons/map-pinned.svg"/><view class="result-main"><view class="name">{{item.name}}</view><view class="address">{{item.address}}</view></view><text wx:if="{{item.distanceMeters}}" class="distance">{{item.distanceMeters}}m</text></view></view>
  <view wx:else class="empty-state">没有找到相关地点</view>
</view></view>
