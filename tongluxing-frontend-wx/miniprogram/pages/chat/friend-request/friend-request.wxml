<view class="page-shell"><td-topbar title="入队申请"/><view class="page-content"><view wx:if="{{loading}}" class="empty-state">正在加载申请…</view><view wx:for="{{requests}}" wx:key="applicationId" class="request card"><view class="avatar"><image wx:if="{{item.avatarImageKey}}" src="{{item.avatarImageKey}}" mode="aspectFill"/><text wx:else>{{item.nickname.slice(0,1)}}</text></view><view class="main"><view class="name">{{item.nickname || '同行用户'}}</view><view class="team">申请加入：{{item.conversationName}}</view><view class="note">{{item.applicationMessage || '希望加入车队，一起出发'}}</view></view><view class="buttons"><view class="reject" data-id="{{item.applicationId}}" data-decision="REJECTED" bindtap="review">拒绝</view><view class="accept" data-id="{{item.applicationId}}" data-decision="APPROVED" bindtap="review">同意</view></view></view><view wx:if="{{!loading && requests.length === 0}}" class="empty-state">暂无待处理的入队申请</view></view></view>
