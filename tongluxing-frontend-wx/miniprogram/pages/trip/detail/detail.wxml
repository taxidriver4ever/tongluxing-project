<view class="detail-page"><view wx:if="{{loading}}" class="loading">正在加载行程…</view><block wx:elif="{{trip}}"><view class="hero" style="padding-top:{{safeTop}}px"><view class="hero-nav"><view class="back" bindtap="back"><image src="/assets/icons/chevron-left.svg"/></view><view>行程详情</view><view class="space"></view></view><view class="pill glass">{{trip.statusText}}</view><view class="hero-title">{{trip.title}}</view><view class="hero-sub">{{trip.departureTime}} · {{trip.distanceText}}</view></view><view class="body"><view class="route-card card"><view class="route-row"><view class="dot start"></view><view><text>出发地</text><text class="strong">{{trip.startLocation.name}}</text><text>{{trip.startLocation.address}}</text></view></view><view class="route-line"></view><view wx:for="{{trip.waypoints}}" wx:key="sortOrder" class="route-row waypoint-row"><view class="dot waypoint"></view><view><text>经停点 {{index + 1}}</text><text class="strong">{{item.name}}</text></view></view><view class="route-line" wx:if="{{trip.waypoints.length}}"></view><view class="route-row"><view class="dot end"></view><view><text>目的地</text><text class="strong">{{trip.endLocation.name}}</text><text>{{trip.endLocation.address}}</text></view></view><view class="route-stats"><view><text class="strong">{{trip.durationText}}</text><text>预计用时</text></view><view><text class="strong">{{trip.distanceText}}</text><text>预计里程</text></view><view><text class="strong">{{trip.peopleText}}</text><text>同行人数</text></view></view></view><view class="actions"><view class="action" bindtap="editRoute"><image src="/assets/icons/route.svg"/><text>路线</text></view><view class="action" bindtap="members"><image src="/assets/icons/users-round.svg"/><text>成员</text></view><view class="action" bindtap="chat"><image src="/assets/icons/message-circle.svg"/><text>进入群聊</text></view><view class="action" bindtap="start"><image src="/assets/icons/download.svg"/><text>下载App开启</text></view></view><view class="section-title">行程说明</view><view class="notice card">{{trip.description || trip.remark || '发起人暂未填写行程说明'}}</view></view></block></view>
