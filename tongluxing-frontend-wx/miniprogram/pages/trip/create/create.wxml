<view class="page-shell create-page"><td-topbar title="创建行程" show-back bind:back="back"/>
<view class="step-bar card"><view wx:for="{{stepLabels}}" wx:key="*this" class="step-item {{step >= index + 1 ? 'active' : ''}}" data-step="{{index + 1}}" bindtap="selectStep"><view class="step-dot">{{index + 1}}</view><text>{{item}}</text></view></view>
<view wx:if="{{loading}}" class="loading">正在读取草稿…</view><view wx:else class="page-content form-content">
<view wx:if="{{step === 1}}"><view class="section-title">基础信息</view><view class="card form-card">
<view class="field"><text class="field-label">行程标题</text><input maxlength="128" placeholder="例如：318川藏线自驾" value="{{title}}" bindinput="onTitle"/></view>
<view class="field split"><view><text class="field-label">出发日期</text><picker mode="date" value="{{date}}" bindchange="onDate"><view class="picker-value">{{date}}</view></picker></view><view><text class="field-label">出发时间</text><picker mode="time" value="{{time}}" bindchange="onTime"><view class="picker-value">{{time}}</view></picker></view></view>
<view class="counter-row"><text>预计人数</text><view class="counter"><button bindtap="minusPeople">−</button><text>{{expectPeople}}</text><button bindtap="plusPeople">＋</button></view></view><view class="counter-row"><text>预计天数</text><view class="counter"><button bindtap="minusDays">−</button><text>{{durationDays}}</text><button bindtap="plusDays">＋</button></view></view>
<view class="field"><text class="field-label">行程描述</text><textarea maxlength="1000" placeholder="介绍路线特色、驾驶要求和集合安排" value="{{description}}" bindinput="onDescription"/></view></view><button class="secondary-btn" loading="{{saving}}" bindtap="saveBasics"><image src="/assets/icons/check.svg"/>保存草稿</button></view>

<view wx:if="{{step === 2}}"><view class="section-title">选择起点与终点</view><view class="card route-card">
<view class="place" data-target="startLocation" bindtap="chooseLocation"><view class="dot start"></view><view><text class="field-label">出发地</text><text class="place-name">{{startLocation ? startLocation.name : '点击选择出发地'}}</text><text class="place-address">{{startLocation ? startLocation.address : ''}}</text></view><image src="/assets/icons/chevron-right.svg"/></view><view class="route-line"></view>
<view class="place" data-target="destination" bindtap="chooseLocation"><view class="dot end"></view><view><text class="field-label">目的地</text><text class="place-name">{{destination ? destination.name : '点击选择目的地'}}</text><text class="place-address">{{destination ? destination.address : ''}}</text></view><image src="/assets/icons/chevron-right.svg"/></view></view>
<button class="primary-btn plan-btn" bindtap="planRoute"><image src="/assets/icons/route.svg"/>生成路线</button><view wx:if="{{route}}" class="card route-result"><view class="result-head"><text>路线已生成</text><text class="status {{route.status === 'VALID' ? 'valid' : 'stale'}}">{{route.status}}</text></view><view class="route-stats"><view><text class="strong">{{routeDistanceText}}</text><text>预计里程</text></view><view><text class="strong">{{routeDurationText}}</text><text>预计用时</text></view><view><text class="strong">{{route.waypoints.length}}</text><text>经停点</text></view></view></view></view>

<view wx:if="{{step === 3}}"><view class="section-title">经停点 <text class="hint">最多 5 个，可调整顺序</text></view><view wx:if="{{waypoints.length === 0}}" class="card empty"><image src="/assets/icons/map.svg"/><text>暂未添加经停点</text><text>经停点不是必填项</text></view>
<view wx:for="{{waypoints}}" wx:key="waypointId" class="card waypoint-card"><view class="sort-badge">{{index + 1}}</view><view class="waypoint-main"><text class="place-name">{{item.name}}</text><text class="place-address">{{item.address}}</text><picker mode="selector" range="{{waypointTypeLabels}}" value="0" data-index="{{index}}" bindchange="changeWaypointType"><view class="type-chip">{{item.type === 'MEETING' ? '集合点' : item.type === 'REST' ? '休息点' : item.type === 'HOTEL' ? '住宿点' : '打卡点'}}</view></picker></view><view class="waypoint-actions"><text data-index="{{index}}" data-direction="-1" bindtap="moveWaypoint">上移</text><text data-index="{{index}}" data-direction="1" bindtap="moveWaypoint">下移</text><text class="delete" data-id="{{item.waypointId}}" bindtap="removeWaypoint">删除</text></view></view>
<picker mode="selector" range="{{waypointTypeLabels}}" value="{{waypointTypeIndex}}" bindchange="onWaypointType"><view class="type-selector">新增类型：{{waypointTypeLabels[waypointTypeIndex]}}</view></picker><button class="secondary-btn" bindtap="addWaypoint"><image src="/assets/icons/circle-plus.svg"/>选择地点并添加</button><view class="route-warning">经停点变化后需要重新生成路线</view><button class="primary-btn plan-btn" bindtap="planRoute">重新生成路线</button></view>

<view wx:if="{{step === 4}}"><view class="section-title">确认行程</view><view class="card confirm-card"><text class="confirm-title">{{title}}</text><text>{{date}} {{time}} 出发 · {{durationDays}} 天 · {{expectPeople}} 人</text><view class="confirm-route"><view class="dot start"></view><text>{{startLocation.name}}</text><view class="line"></view><view class="dot end"></view><text>{{destination.name}}</text></view><view class="confirm-row"><text>经停点</text><text>{{waypoints.length}} 个</text></view><view class="confirm-row"><text>预计里程</text><text>{{routeDistanceText}}</text></view><text class="description">{{description || '未填写行程描述'}}</text></view><view class="publish-note"><image src="/assets/icons/shield-alert.svg"/><text>发布后其他用户可以浏览该行程，请确认信息准确。</text></view><button class="primary-btn publish-btn" loading="{{publishing}}" bindtap="publish">确认发布</button></view>
<view class="footer-actions"><button wx:if="{{step > 1}}" class="ghost-btn" bindtap="previous">上一步</button><button wx:if="{{step < 4}}" class="primary-btn next-btn" bindtap="next">下一步</button></view></view></view>
