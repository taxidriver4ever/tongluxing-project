<view class="login-page">
  <view class="page-content">
    <view class="brand">同路行</view>
    <view class="form-card">
      <view class="welcome">欢迎回来</view>
      <view class="welcome">开启下一段旅程</view>
      <view class="field-label">手机号</view>
      <input class="field" type="number" maxlength="11" placeholder="请输入微信注册手机号" value="{{phone}}" bindinput="onPhoneInput" />
      <view class="field-label password-label">密码</view>
      <input class="field" password maxlength="32" placeholder="••••••••" value="{{password}}" bindinput="onPasswordInput" confirm-type="done" bindconfirm="onLogin" />
      <button class="action primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onLogin">登录</button>
      <view class="divider"><view></view><text>或</text><view></view></view>
      <button class="action secondary" open-type="getPhoneNumber" loading="{{loading}}" disabled="{{loading}}" bindgetphonenumber="onWechatLogin">微信手机号一键登录</button>
    </view>
    <view class="footer">首次微信登录会自动创建账号</view>
  </view>
</view>
