<view class="page-shell">
  <td-topbar title="优惠券详情"/>
  <view class="page-content">
    <view wx:if="{{loading}}" class="empty-state">加载中...</view>
    <view wx:elif="{{error}}" class="empty-state">{{error}}</view>
    <block wx:elif="{{coupon}}">
      <view class="coupon">
        <view class="coupon-top">
          <view class="amount"><text>¥</text>{{coupon.amount}}</view>
          <view>
            <view class="title">{{coupon.title}}</view>
            <view class="threshold">{{coupon.threshold}}</view>
          </view>
        </view>
        <view class="cut-line"></view>
        <view class="coupon-bottom">
          <view><text>有效期</text><text class="strong">截至 {{coupon.expiry}}</text></view>
          <view class="code">{{coupon.code}}</view>
        </view>
      </view>
      <view class="section-title">使用说明</view>
      <view class="rules card">
        <view>1. 仅限支持该优惠券的合作服务点使用</view>
        <view>2. 每笔订单限使用一张优惠券</view>
        <view>3. 优惠券不可兑换现金或找零</view>
        <view>4. 过期后自动失效</view>
      </view>
      <view class="primary-btn" bindtap="use">立即使用</view>
    </block>
  </view>
</view>
