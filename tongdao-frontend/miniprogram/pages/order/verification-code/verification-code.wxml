<view class="page-shell">
  <td-topbar title="核销码" placeholder="到店向商家出示" action="码" />
  <view class="page-content">
    <view class="card code-card">
      <view class="pill green">{{statusText}}</view>
      <view class="qr">
        <view class="qr-grid"></view>
      </view>
      <view class="code">{{codeText}}</view>
      <view class="tip">当前用户端只展示订单核销状态；真实核销码生成需后端明确用户侧入口参数。</view>
    </view>

    <view class="card info-card">
      <view class="section-title">订单信息</view>
      <view class="pay-row"><text>订单号</text><text>{{order.orderNo || '-'}}</text></view>
      <view class="pay-row"><text>商品</text><text>#{{order.productId || '-'}}</text></view>
      <view class="pay-row"><text>商家</text><text>#{{order.merchantId || '-'}}</text></view>
      <view class="pay-row"><text>金额</text><text>￥{{order.payableAmount || 0}}</text></view>
    </view>
  </view>
</view>
