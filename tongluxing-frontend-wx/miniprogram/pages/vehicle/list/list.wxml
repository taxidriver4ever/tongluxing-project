<view class="vehicle-page"><view class="back" bindtap="back"><image src="/assets/icons/chevron-left.svg"/></view><scroll-view scroll-y class="page"><view class="header">我的车辆</view><view class="desc">管理你的车辆信息，设置常用车辆</view><view wx:if="{{loading}}" class="empty-state">正在加载车辆…</view><view wx:for="{{vehicles}}" wx:key="vehicleId" class="vehicle-card"><view class="card-header"><view class="top"><view class="car-img"><image wx:if="{{item.vehiclePhotoImageKey}}" src="{{item.vehiclePhotoImageKey}}" mode="aspectFill"/><image wx:else src="/assets/icons/car-front.svg"/></view><view class="info"><view class="name">{{item.brand || '未填写品牌'}} {{item.model}}</view><view class="plate">{{item.plateNoMask || '车牌待补充'}}</view><view class="status">{{item.certificationStatus === 'APPROVED' ? '已认证' : item.certificationStatus === 'PENDING' ? '审核中' : '未认证'}}</view><view wx:if="{{item.isDefault}}" class="main-text">目前主要车辆</view></view></view><view class="detail" data-id="{{item.vehicleId}}" bindtap="detail">查看详情</view></view><view wx:if="{{!item.isDefault}}" class="set" data-id="{{item.vehicleId}}" bindtap="setDefault">设为主要车辆</view></view><view wx:if="{{!loading && !vehicles.length}}" class="empty-state">暂未添加车辆</view><view class="add" bindtap="add"><image src="/assets/icons/circle-plus.svg"/><text>添加车辆</text></view><view class="page-spacer"></view></scroll-view></view>
