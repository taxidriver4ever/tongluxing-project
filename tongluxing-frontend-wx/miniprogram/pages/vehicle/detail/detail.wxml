<view class="page-shell"><td-topbar title="车辆详情"/><view class="page-content"><view wx:if="{{loading}}" class="empty-state">正在加载车辆…</view><block wx:elif="{{vehicle}}"><view class="vehicle-hero card"><view class="car"><image src="/assets/icons/car-front.svg"/></view><view class="title">{{vehicle.brand || '未填写品牌'}} {{vehicle.model}}</view><view class="plate">{{vehicle.plateNoMask || '车牌待补充'}}</view><view class="pill">{{vehicle.certificationStatus === 'APPROVED' ? '已认证' : vehicle.certificationStatus === 'PENDING' ? '审核中' : '待认证'}}</view></view><view class="section-title">车辆资料</view><view class="info card"><view><text>车辆颜色</text><text class="strong">{{vehicle.color || '未填写'}}</text></view><view><text>车辆类型</text><text class="strong">{{vehicle.vehicleType || '未填写'}}</text></view><view><text>座位数</text><text class="strong">{{vehicle.seatCount}}座</text></view><view><text>能源类型</text><text class="strong">{{vehicle.energyType || '未填写'}}</text></view><view><text>默认车辆</text><text class="strong">{{vehicle.isDefault ? '是' : '否'}}</text></view></view><view class="secondary-btn" bindtap="certify">{{vehicle.certificationStatus === 'REJECTED' ? '重新提交认证' : '查看/提交车辆认证'}}</view><view class="secondary-btn" bindtap="edit">编辑车辆</view><view class="danger" bindtap="remove">删除车辆</view></block></view></view>
