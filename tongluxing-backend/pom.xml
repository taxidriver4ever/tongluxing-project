<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tongluxing</groupId>
    <artifactId>tongluxing-backend</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>tongluxing-backend</name>
    <description>Tongluxing backend parent project</description>

    <modules>
        <module>tongluxing-app</module>
        <module>tongluxing-common</module>
        <module>auth-module</module>
        <module>user-module</module>
        <module>growth-module</module>
        <module>invite-module</module>
        <module>coupon-module</module>
        <module>vehicle-module</module>
        <module>trip-module</module>
        <module>match-module</module>
        <module>team-module</module>
        <module>chat-module</module>
        <module>map-module</module>
        <module>merchant-module</module>
        <module>groupbuy-module</module>
        <module>order-module</module>
        <module>payment-module</module>
        <module>verification-module</module>
        <module>assessment-module</module>
        <module>customer-service-module</module>
        <module>notify-module</module>
        <module>admin-module</module>
        <module>storage-module</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-boot.version>3.5.14</spring-boot.version>
        <mybatis.version>3.0.5</mybatis.version>
        <maven.compiler.plugin.version>3.14.0</maven.compiler.plugin.version>
        <spring-boot.maven.plugin.version>${spring-boot.version}</spring-boot.maven.plugin.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>tongluxing-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>auth-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>user-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>growth-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>invite-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>coupon-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>vehicle-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>trip-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>match-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>team-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>chat-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>map-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>merchant-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>groupbuy-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>order-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>payment-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>verification-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>assessment-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>customer-service-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>notify-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>admin-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tongluxing</groupId>
                <artifactId>storage-module</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.maven.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
