<view class="page-shell"><td-topbar title="车队管理"/><view class="page-content"><view class="section-title"><text>加入申请</text><text class="section-more">{{requests.length}} 条待处理</text></view><view class="request card" wx:for="{{requests}}" wx:key="id"><view class="avatar">{{item.avatar}}</view><view class="request-main"><view class="name">{{item.name}}</view><view class="desc">{{item.car}} · 驾龄{{item.years}}年</view></view><view class="actions"><view class="reject" data-id="{{item.id}}" bindtap="reject">拒绝</view><view class="approve" data-id="{{item.id}}" bindtap="approve">同意</view></view></view><view class="section-title">管理设置</view><view class="settings card"><view class="setting" bindtap="goMembers"><text>成员管理</text><text>›</text></view><view class="setting"><text>允许成员邀请</text><switch checked color="#3A86FF"/></view><view class="setting"><text>新成员需要审核</text><switch checked color="#3A86FF"/></view></view><view class="danger" bindtap="dismiss">解散车队</view></view></view>
