<view class="coupon-page"><scroll-view scroll-y class="page"><view class="header"><view class="back" bindtap="back"><image src="/assets/icons/chevron-left.svg"/></view><text>我的券包</text></view><view class="tabs"><view wx:for="{{tabs}}" wx:key="key" class="tab {{active === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="change">{{item.label}}</view></view><view wx:for="{{visible}}" wx:key="id" class="ticket"><view class="ticket-top"><view class="ticket-type">{{item.title}}</view><view class="ticket-value">¥{{item.amount}}.00</view><view class="ticket-name">{{item.threshold}}</view><view class="ticket-expire">有效期至 {{item.expiry}}</view></view><view class="ticket-bottom"><view class="ticket-action" data-id="{{item.id}}" bindtap="detail">查看详情</view><view class="ticket-action">立即使用</view></view></view><view wx:if="{{visible.length === 0}}" class="empty-state">当前没有优惠券</view></scroll-view></view>
