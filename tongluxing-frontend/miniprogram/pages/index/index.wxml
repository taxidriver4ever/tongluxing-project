<view class="map-page">
  <view class="map-canvas">
    <view class="road r1"></view>
    <view class="road r2"></view>
    <view class="road r3"></view>
    <view class="road r4"></view>
    <view class="marker mycar">车</view>
    <view class="marker car c1">友</view>
    <view class="marker car c2">友</view>
    <view class="marker car c3">友</view>
    <view class="team-range"></view>
    <view class="marker team-car t1">队</view>
    <view class="marker team-car t2">2</view>
    <view class="marker poi p1">油</view>
    <view class="marker poi p2">团</view>
    <view class="marker poi p3">餐</view>
    <view class="marker poi p4">住</view>
    <view class="hot-chat">附近拼团 4</view>
  </view>

  <td-topbar title="成都·锦江" placeholder="搜目的地、车队、拼团商家" action="铃" />
  <view class="floating-list" bindtap="goNearbyTeams">车队</view>

  <view class="bottom-actions">
    <view class="trip-mini">
      <text><text class="strong">{{teams.length ? teams[0].teamName : '附近探索'}}</text> · {{markers.length}} 个地图标记</text>
      <text>{{teams.length ? (teams[0].overlapRate + '%') : '刷新'}}</text>
    </view>
    <view wx:if="{{teams.length}}" class="near-team-list">
      <view wx:for="{{teams}}" wx:key="teamId" class="near-team" data-id="{{item.teamId}}" bindtap="goTeamDetail">
        <text>{{item.teamName}}</text>
        <text>{{item.currentMemberCount}}/{{item.maxMemberCount}}车 · {{item.overlapRate}}%</text>
      </view>
    </view>
    <view class="groupbuy-card" bindtap="goGroupbuyList">
      <view>
        <view class="groupbuy-title">沿途补给拼团</view>
        <view class="groupbuy-desc">路线重合 86% · 已有 5 车同行 · 最近商家距你 2.1km</view>
      </view>
      <view class="groupbuy-action">看拼团</view>
    </view>
    <view class="action-grid">
      <view class="action">发动态<text>沿途随手拍</text></view>
      <view class="action" bindtap="goPublishTrip">设行程<text>开始组队</text></view>
      <view class="action sos" bindtap="goSos">SOS<text>长按3秒</text></view>
    </view>
  </view>

  <td-tabbar active="map" />
</view>
