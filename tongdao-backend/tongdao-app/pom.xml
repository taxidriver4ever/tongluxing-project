<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tongdao</groupId>
        <artifactId>tongdao-backend</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tongdao-app</artifactId>
    <name>tongdao-app</name>
    <description>Tongdao Spring Boot application</description>

    <dependencies>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>tongdao-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>auth-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>user-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>growth-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>invite-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>coupon-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>vehicle-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>trip-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>match-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>team-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>chat-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>map-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>merchant-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>groupbuy-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>order-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>payment-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>verification-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>assessment-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>customer-service-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>notify-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tongdao</groupId>
            <artifactId>admin-module</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.tongdao.TongdaoApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
