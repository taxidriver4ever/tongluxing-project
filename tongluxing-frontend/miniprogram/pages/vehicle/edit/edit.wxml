<view class="page-shell vehicle-edit-page">
  <td-topbar title="{{isEdit ? '编辑车辆' : '填写车辆信息'}}" placeholder="保存后刷新我的车辆" action="车" />
  <scroll-view scroll-y class="page-content">
    <view class="form-card card">
      <view class="field">
        <view class="label">品牌</view>
        <input class="input" value="{{form.brand}}" data-field="brand" bindinput="onInput" maxlength="64" placeholder="例如：坦克" />
      </view>
      <view class="field">
        <view class="label">车型</view>
        <input class="input" value="{{form.model}}" data-field="model" bindinput="onInput" maxlength="64" placeholder="例如：300" />
      </view>
      <view class="field">
        <view class="label">车牌号</view>
        <input class="input" value="{{form.plateNo}}" data-field="plateNo" bindinput="onInput" maxlength="16" placeholder="例如：粤A12348" disabled="{{isEdit}}" />
        <view wx:if="{{isEdit}}" class="field-tip">车牌号已脱敏展示，编辑车辆时不修改车牌。</view>
      </view>
      <view class="field">
        <view class="label">车辆类型</view>
        <input class="input" value="{{form.vehicleType}}" data-field="vehicleType" bindinput="onInput" maxlength="32" placeholder="SUV / 轿车 / MPV" />
      </view>
      <view class="field-row">
        <view class="field">
          <view class="label">颜色</view>
          <input class="input" value="{{form.color}}" data-field="color" bindinput="onInput" maxlength="32" placeholder="灰色" />
        </view>
        <view class="field">
          <view class="label">座位数</view>
          <input class="input" type="number" value="{{form.seatCount}}" bindinput="onSeatInput" placeholder="5" />
        </view>
      </view>
      <view class="field">
        <view class="label">能源类型</view>
        <input class="input" value="{{form.energyType}}" data-field="energyType" bindinput="onInput" maxlength="32" placeholder="燃油 / 纯电 / 混动" />
      </view>
      <view class="field">
        <view class="label">车辆照片标识</view>
        <input class="input" value="{{form.vehiclePhotoImageKey}}" data-field="vehiclePhotoImageKey" bindinput="onInput" placeholder="/static/upload/car.jpg" />
        <view class="upload-box" bindtap="chooseVehicleImage">
          <view class="upload-title">选择车辆照片</view>
          <view class="upload-sub">{{form.vehiclePhotoImageKey ? form.vehiclePhotoImageKey : '当前仅保存本地临时路径或手动填写资源标识'}}</view>
        </view>
      </view>
    </view>

    <view class="btn save-btn {{loading ? 'gray' : ''}}" bindtap="onSave">{{loading ? '保存中...' : '保存车辆信息'}}</view>
  </scroll-view>
</view>
