<view class="detail-page"><view class="hero" style="padding-top:{{safeTop}}px"><view class="hero-nav"><view class="back" bindtap="back"><image src="/assets/icons/chevron-left.svg"/></view><view>车队详情</view><view class="space"></view></view><view wx:if="{{team}}" class="avatar">{{team.teamName.slice(0,1)}}</view><view class="hero-title">{{team ? team.teamName : '正在加载车队'}}</view><view wx:if="{{team}}" class="hero-sub">{{team.currentMemberCount}}/{{team.maxMemberCount}} 人 · {{team.teamStatus === 'RECRUITING' ? '招募中' : team.teamStatus}}</view></view><view class="body"><view wx:if="{{loading}}" class="empty-state">正在加载车队信息…</view><block wx:elif="{{team}}"><view class="route-card card"><view class="label">当前路线</view><view class="route-name">{{team.startName}} → {{team.endName}}</view><view class="notice">{{team.teamDesc || '和同路伙伴一起安全出发'}}</view></view><view class="actions"><view class="action" bindtap="route"><image src="/assets/icons/route.svg"/><text>路线</text></view><view class="action" bindtap="members"><image src="/assets/icons/users-round.svg"/><text>成员</text></view><view class="action" bindtap="chat"><image src="/assets/icons/message-circle.svg"/><text>进入群聊</text></view><view wx:if="{{isOwner}}" class="action" bindtap="manage"><image src="/assets/icons/settings.svg"/><text>管理</text></view></view><view class="section-title">车队公告</view><view class="card announcement">{{team.notice || '队长暂未发布车队公告'}}</view><view wx:if="{{!isOwner && team.teamStatus === 'RECRUITING'}}" class="primary-btn join" bindtap="join">申请加入车队</view></block></view></view>
