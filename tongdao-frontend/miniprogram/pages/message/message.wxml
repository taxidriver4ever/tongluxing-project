<view class="page-shell">
  <td-topbar title="消息" placeholder="搜索会话、车队、客服" action="点" />

  <view class="chat-list">
    <view wx:for="{{chats}}" wx:key="conversationId" class="chat-item" data-id="{{item.conversationId}}" data-title="{{item.conversationName}}" data-group="team_{{item.bizId}}" bindtap="openChat">
      <td-avatar text="{{item.avatar}}" theme="{{item.theme}}" />
      <view class="chat-main">
        <view class="chat-name">
          <text>{{item.conversationName}}</text>
          <text>{{item.lastMessageAt || item.providerType}}</text>
        </view>
        <view class="chat-preview">{{item.lastMessagePreview || '暂无消息，点击进入群聊'}}</view>
      </view>
      <view wx:if="{{item.badge}}" class="badge">{{item.badge}}</view>
    </view>
    <view wx:if="{{chats.length === 0 && !loading}}" class="empty-chat">暂无会话，加入车队后会在这里显示群聊。</view>
  </view>

  <td-tabbar active="message" />
</view>
