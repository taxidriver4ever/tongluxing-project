<view class="growth-page"><view class="back" bindtap="back"><image src="/assets/icons/chevron-left.svg"/></view><scroll-view scroll-y class="page"><view class="header">成长中心</view><view wx:if="{{loading}}" class="empty-state">正在加载成长数据…</view><block wx:elif="{{summary}}"><view class="level-card"><view class="level-row"><view><view class="level">{{summary.levelText}}</view><view class="tip">持续同行，解锁更多等级</view></view><view class="points">{{summary.totalPoints}} 成长值</view></view><view class="progress"><view class="bar" style="width:{{summary.progress}}%"></view></view><view class="tip">距离下一等级还需要 {{summary.remain}} 成长值</view></view><view class="data-card"><view class="title">成长数据</view><view class="stats"><view class="item"><view class="num">{{summary.totalPoints}}</view><view class="label">累计成长值</view></view><view class="item"><view class="num">{{logs.length}}</view><view class="label">成长记录</view></view><view class="item"><view class="num">{{badgeCount}}</view><view class="label">获得勋章</view></view></view></view><view class="data-card"><view class="title">成长记录</view><view wx:for="{{logs}}" wx:key="id" class="row"><view><view class="name">{{item.remark || item.bizType}}</view><view class="time">{{item.createdAt}}</view></view><view class="value">{{item.pointDelta > 0 ? '+' : ''}}{{item.pointDelta}}</view></view><view wx:if="{{!logs.length}}" class="empty-small">暂无成长记录</view></view><view class="btn" bindtap="badges">查看我的全部勋章</view></block><view class="page-spacer"></view></scroll-view></view>
