<view class="page-shell vehicle-cert-page">
  <td-topbar title="车辆认证" />
  <scroll-view scroll-y class="page-content">
    <view class="status-card card"><view><view class="status-title">提交车辆与证件材料</view><view class="status-sub">{{submitTime || '从相册选择图片，先上传对象存储再提交审核'}}</view></view><view class="pill {{status === 'PASS' ? 'green' : status === 'PENDING' ? 'orange' : status === 'REJECT' ? 'red' : ''}}">{{status === 'PASS' ? '已通过' : status === 'PENDING' ? '审核中' : status === 'REJECT' ? '已拒绝' : '未提交'}}</view></view>
    <view wx:if="{{reason}}" class="notice reject"><view class="notice-title">未通过原因</view><view>{{reason}}</view></view>

    <view class="section-title">车辆基础信息</view>
    <view class="form-card card">
      <view class="field"><view class="label">车牌号码</view><input class="input" value="{{form.plateNumber}}" data-field="plateNumber" bindinput="onInput" placeholder="例如 粤A12345" disabled="{{status === 'PENDING' || status === 'PASS'}}" /></view>
      <view class="field"><view class="label">车辆品牌</view><input class="input" value="{{form.vehicleBrand}}" data-field="vehicleBrand" bindinput="onInput" placeholder="例如 理想" disabled="{{status === 'PENDING' || status === 'PASS'}}" /></view>
      <view class="field"><view class="label">车辆型号</view><input class="input" value="{{form.vehicleModel}}" data-field="vehicleModel" bindinput="onInput" placeholder="例如 L7 Max" disabled="{{status === 'PENDING' || status === 'PASS'}}" /></view>
      <view class="field"><view class="label">车辆颜色</view><input class="input" value="{{form.vehicleColor}}" data-field="vehicleColor" bindinput="onInput" placeholder="例如 星环灰" disabled="{{status === 'PENDING' || status === 'PASS'}}" /></view>
    </view>

    <view class="section-title">车辆行驶证</view>
    <view class="material-desc">主页与副页均需清晰完整</view>
    <view class="upload-grid card">
      <view class="upload-box" data-group="registrationLicenseImages" data-index="0" bindtap="chooseImage"><image wx:if="{{registrationLicenseImages[0]}}" src="{{registrationLicenseImages[0]}}" mode="aspectFill"/><view wx:else><view class="upload-plus">＋</view><view>行驶证主页</view><text>必填</text></view></view>
      <view class="upload-box" data-group="registrationLicenseImages" data-index="1" bindtap="chooseImage"><image wx:if="{{registrationLicenseImages[1]}}" src="{{registrationLicenseImages[1]}}" mode="aspectFill"/><view wx:else><view class="upload-plus">＋</view><view>行驶证副页</view><text>必填</text></view></view>
    </view>

    <view class="section-title">车辆照片</view>
    <view class="material-desc">正面照必传，侧面与后方照片选填</view>
    <view class="upload-grid three card">
      <view class="upload-box" data-group="vehicleImages" data-index="0" bindtap="chooseImage"><image wx:if="{{vehicleImages[0]}}" src="{{vehicleImages[0]}}" mode="aspectFill"/><view wx:else><view class="upload-plus">＋</view><view>车辆正面照</view><text>必填</text></view></view>
      <view class="upload-box" data-group="vehicleImages" data-index="1" bindtap="chooseImage"><image wx:if="{{vehicleImages[1]}}" src="{{vehicleImages[1]}}" mode="aspectFill"/><view wx:else><view class="upload-plus">＋</view><view>车辆侧面照</view><text>选填</text></view></view>
      <view class="upload-box" data-group="vehicleImages" data-index="2" bindtap="chooseImage"><image wx:if="{{vehicleImages[2]}}" src="{{vehicleImages[2]}}" mode="aspectFill"/><view wx:else><view class="upload-plus">＋</view><view>车辆后方照</view><text>选填</text></view></view>
    </view>

    <view class="notice"><view class="notice-title">上传说明</view><view>小程序会向后端获取上传签名，将图片直传对象存储，并只提交 objectKey。驾驶证认证请在“我的—驾驶证认证”中独立完成。</view></view>
    <view wx:if="{{status !== 'PENDING' && status !== 'PASS'}}" class="btn submit-btn {{loading ? 'gray' : ''}}" bindtap="onSubmit">{{loading ? savingLabel : status === 'REJECT' ? '重新上传并提交' : '上传并提交认证'}}</view>
    <view class="bottom-safe"></view>
  </scroll-view>
</view>
