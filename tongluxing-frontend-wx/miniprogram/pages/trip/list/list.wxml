<view class="page-shell"><td-topbar title="我的行程"/><view class="filter"><view wx:for="{{filters}}" wx:key="key" class="filter-item {{active === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="changeFilter">{{item.label}}</view></view><view class="page-content list"><view wx:if="{{loading}}" class="empty-state">正在加载行程…</view><view wx:for="{{visibleTrips}}" wx:key="tripId" class="trip-card card" data-id="{{item.tripId}}" bindtap="goDetail"><view class="row"><view class="name">{{item.title || '自驾行程'}}</view><view class="pill">{{item.statusText}}</view></view><view class="route">{{item.routeText}}</view><view class="meta">{{item.metaText}}</view></view><view wx:if="{{!loading && !visibleTrips.length}}" class="empty-state">当前分类暂无行程</view></view></view>
