<view class="page-shell"><td-topbar title="路线与途经点"/><view class="page-content"><view wx:if="{{loading}}" class="empty-state">正在加载路线…</view><block wx:elif="{{draft}}"><view class="route-summary card"><view class="place"><view class="dot start"></view><view><text>出发地</text><text class="strong">{{draft.startLocation ? draft.startLocation.name : '尚未设置'}}</text></view></view><view class="line"></view><view wx:for="{{waypoints}}" wx:key="waypointId" class="place waypoint"><view class="dot point"></view><view class="main"><text class="strong">{{item.name}}</text><text>{{item.address}}</text></view><view class="remove" data-id="{{item.waypointId}}" bindtap="remove">移除</view></view><view class="line"></view><view class="place"><view class="dot end"></view><view><text>目的地</text><text class="strong">{{draft.destination ? draft.destination.name : '尚未设置'}}</text></view></view></view><view class="add" bindtap="add">＋ 添加途经点</view><view class="primary-btn confirm" bindtap="confirm">确认并重新规划路线</view></block></view></view>
