<view class="page-shell vehicle-cert-page">
  <td-topbar title="车辆认证" placeholder="提交行驶证和车辆信息" action="证" />
  <scroll-view scroll-y class="page-content">
    <view class="status-card card">
      <view>
        <view class="status-title">{{vehicle.brand || "车辆"}} {{vehicle.model || ""}}</view>
        <view class="status-sub">{{vehicle.plateNoMask || "未填写车牌"}} · {{vehicle.vehicleType || "车辆类型"}}</view>
      </view>
      <view class="pill {{status === 'APPROVED' ? 'green' : status === 'PENDING' ? 'orange' : status === 'REJECTED' ? 'red' : ''}}">
        {{status === 'APPROVED' ? '已认证' : status === 'PENDING' ? '审核中' : status === 'REJECTED' ? '审核拒绝' : '未提交'}}
      </view>
    </view>

    <view wx:if="{{rejectReason}}" class="notice reject">
      <view class="notice-title">认证被拒</view>
      <view>{{rejectReason}}</view>
    </view>

    <view class="form-card card">
      <view class="field">
        <view class="label">所有人</view>
        <input class="input" value="{{form.ownerName}}" data-field="ownerName" bindinput="onInput" maxlength="64" placeholder="请输入行驶证所有人" disabled="{{status === 'PENDING' || status === 'APPROVED'}}" />
      </view>
      <view class="field">
        <view class="label">车牌号</view>
        <input class="input" value="{{form.plateNo}}" data-field="plateNo" bindinput="onInput" maxlength="16" placeholder="例如：粤A12348" disabled="{{status === 'PENDING' || status === 'APPROVED'}}" />
      </view>
      <view class="field">
        <view class="label">车架号 VIN</view>
        <input class="input" value="{{form.vin}}" data-field="vin" bindinput="onInput" maxlength="32" placeholder="选填，建议填写" disabled="{{status === 'PENDING' || status === 'APPROVED'}}" />
      </view>
      <view class="field">
        <view class="label">发动机号</view>
        <input class="input" value="{{form.engineNo}}" data-field="engineNo" bindinput="onInput" maxlength="32" placeholder="选填" disabled="{{status === 'PENDING' || status === 'APPROVED'}}" />
      </view>
      <view class="field">
        <view class="label">行驶证照片标识</view>
        <input class="input" value="{{form.licenseImageKey}}" data-field="licenseImageKey" bindinput="onInput" placeholder="/static/upload/license.jpg" disabled="{{status === 'PENDING' || status === 'APPROVED'}}" />
        <view class="upload-box" bindtap="chooseLicenseImage">
          <view class="upload-title">上传行驶证照片</view>
          <view class="upload-sub">{{form.licenseImageKey ? form.licenseImageKey : '当前仅保存本地临时路径或手动填写资源标识'}}</view>
        </view>
      </view>
    </view>

    <view class="notice">
      <view class="notice-title">隐私保护</view>
      <view>车牌、车架号等敏感信息由后端脱敏展示，公开车辆卡片不会展示行驶证和完整编号。</view>
    </view>

    <view wx:if="{{status !== 'PENDING' && status !== 'APPROVED'}}" class="btn submit-btn {{loading ? 'gray' : ''}}" bindtap="onSubmit">
      {{loading ? '提交中...' : '提交车辆认证'}}
    </view>
  </scroll-view>
</view>
