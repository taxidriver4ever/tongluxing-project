<view class="map-page">
  <map class="map" latitude="{{latitude}}" longitude="{{longitude}}" scale="13" markers="{{markers}}" show-location enable-traffic="{{trafficEnabled}}" />
  <view class="search" style="top:{{contentTop}}px" bindtap="goSearch"><image src="/assets/icons/search.svg"/><text>{{selectedName || '搜索地点、路线或车队'}}</text></view>
  <view class="tools" style="top:{{contentTop + 66}}px">
    <view class="tool" bindtap="locate"><image src="/assets/icons/locate-fixed.svg"/><text>定位</text></view>
    <view class="tool {{trafficEnabled ? 'active' : ''}}" bindtap="toggleTraffic"><image src="/assets/icons/layers.svg"/><text>路况</text></view>
    <view class="tool sos" bindtap="sos"><image src="/assets/icons/shield-alert.svg"/><text>SOS</text></view>
  </view>
  <view class="main-card">
    <view class="card-title"><image src="/assets/icons/route.svg"/><text>规划下一段旅程</text></view>
    <view class="desc">创建路线、管理经停点，准备开始自驾</view>
    <view class="publish" bindtap="goCreateTrip">创建行程</view>
  </view>
  <td-tabbar active="map" />
</view>
