<view class="page-shell public-page">
  <td-topbar title="个人主页" />
  <view class="page-content">
    <view wx:if="{{loading}}" class="state-card card">正在加载个人主页…</view>
    <view wx:elif="{{error}}" class="state-card card"><text>{{error}}</text><view class="retry" bindtap="retry">重新加载</view></view>
    <block wx:elif="{{homepage}}">
      <view class="hero-card">
        <view class="avatar" bindtap="edit">
          <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
          <text wx:else>{{avatarText}}</text>
        </view>
        <view class="owner-hint" wx:if="{{isOwner}}">点击头像可编辑资料</view>
        <view class="name">{{homepage.profile.nickname || '同路行用户'}}</view>
        <view class="bio">{{homepage.profile.bio || '愿每一次出发都有同路人'}}</view>
        <view class="tags">
          <view class="tag">{{homepage.growth.levelCode || 'LV1'}}</view>
          <view class="tag">{{homepage.profile.drivingLicenseCertificationStatus === 'APPROVED' ? '驾驶认证' : '资料已公开'}}</view>
          <view wx:if="{{homepage.profile.cityName}}" class="tag">{{homepage.profile.cityName}}</view>
          <view class="tag">IP：{{homepage.ipProvince || '未知'}}</view>
        </view>
      </view>

      <view class="stats">
        <view class="stat card"><view class="value">{{homepage.profile.totalTripCount || 0}}</view><view class="label">出行次数</view><view class="unit">次</view></view>
        <view class="stat card"><view class="value">{{distanceKm}}</view><view class="label">累计里程</view><view class="unit">km</view></view>
        <view class="stat card"><view class="value">{{homepage.profile.completedWaypointCount || 0}}</view><view class="label">经停点</view><view class="unit">个</view></view>
      </view>

      <view class="growth card">
        <image src="/assets/icons/medal.svg" />
        <view class="growth-main">
          <view class="growth-title">成长与荣誉</view>
          <view class="growth-copy">{{homepage.growth.totalPoints || 0}} 成长值 · {{homepage.badges.earned.length}} 枚勋章</view>
        </view>
      </view>
    </block>
  </view>
</view>
