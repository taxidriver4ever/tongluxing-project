<view class="page-shell"><td-topbar title="聊天详情"/><view class="page-content"><view wx:if="{{loading}}" class="empty-state">正在加载群聊信息…</view><block wx:else><view class="group card"><view class="group-avatar">{{conversation ? conversation.conversationName.slice(0,1) : '群'}}</view><view><view class="group-name">{{conversation ? conversation.conversationName : '行程群聊'}}</view><view class="group-sub">{{members.length}} 位成员 · {{conversation && conversation.conversationStatus === 'ACTIVE' ? '群聊进行中' : '群聊已结束'}}</view></view></view><view class="functions"><view class="function" bindtap="members"><view class="icon"><image src="/assets/icons/users-round.svg"/></view><text>群组成员</text></view><view class="function" bindtap="trip"><view class="icon"><image src="/assets/icons/route.svg"/></view><text>关联行程</text></view><view class="function" bindtap="sharedLocation"><view class="icon"><image src="/assets/icons/map-pinned.svg"/></view><text>共享位置</text></view><view class="function" bindtap="search"><view class="icon"><image src="/assets/icons/search.svg"/></view><text>查找记录</text></view></view><view class="settings card"><view class="row"><text>消息免打扰</text><switch checked="{{settings.muted}}" data-key="muted" bindchange="toggle" color="#3A86FF"/></view><view class="row"><text>置顶聊天</text><switch checked="{{settings.pinned}}" data-key="pinned" bindchange="toggle" color="#3A86FF"/></view><view class="row"><text>群聊名称</text><text class="muted">{{conversation ? conversation.conversationName : '--'}}</text></view></view><view class="exit" bindtap="exit">退出群聊</view></block></view></view>
