<view class="page-shell"><td-topbar title="全部行程"/><view class="filter"><view wx:for="{{filters}}" wx:key="key" class="filter-item {{active === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="changeFilter">{{item.label}}</view></view><view class="page-content list"><view wx:for="{{visibleTrips}}" wx:key="id" class="trip-card card" data-id="{{item.id}}" bindtap="goDetail"><view class="row"><view class="name">{{item.title}}</view><view class="pill">{{item.date}}</view></view><view class="route">{{item.start}} → {{item.end}}</view><view class="meta">{{item.time}} · {{item.distance}} · {{item.members}}/{{item.capacity}}人</view></view></view></view>
