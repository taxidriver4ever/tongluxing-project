<view class="detail-page">
  <view class="hero">
    <td-topbar title="拼团详情" placeholder="分享给车队" action="享" />
    <view class="hero-copy">
      <view class="hero-title">{{title}}</view>
      <view class="hero-sub">{{subtitle}}</view>
    </view>
  </view>

  <scroll-view scroll-y class="detail-content">
    <view class="deal-card card">
      <view class="price-line">
        <view><text class="price">￥{{activity.groupPrice || 0}}</text></view>
        <view class="pill orange">{{activity.activityStatus || "UNKNOWN"}}</view>
      </view>
      <view class="progress"><view class="bar" style="width:{{progressPercent}}%"></view></view>
      <view class="progress-text">已参团 {{progressText}}</view>
    </view>

    <view class="card section">
      <view class="section-title">阶梯价格</view>
      <view class="step-row active"><text>目标人数</text><text>{{activity.targetPeople || 0}} 人</text></view>
      <view class="step-row active"><text>当前人数</text><text>{{activity.currentPeople || 0}} 人</text></view>
      <view class="step-row"><text>拼团价格</text><text>￥{{activity.groupPrice || 0}}</text></view>
    </view>

    <view class="card section">
      <view class="section-title">商家保障</view>
      <view class="tag-row">
        <view class="pill green">L4 金牌商家</view>
        <view class="pill">核销后分账</view>
        <view class="pill orange">客服可介入</view>
      </view>
    </view>
  </scroll-view>

  <view class="bottom-bar">
    <view class="btn ghost">发起拼团</view>
    <view class="btn" bindtap="goCheckout">立即参团</view>
  </view>
</view>
