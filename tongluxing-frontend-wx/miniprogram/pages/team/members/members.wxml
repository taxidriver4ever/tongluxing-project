<view class="page-shell"><td-topbar title="车队成员"/><view class="page-content"><view class="summary card"><view class="avatars"><view wx:for="{{members}}" wx:key="id" class="mini-avatar">{{item.avatar}}</view></view><view><view class="summary-title">川西慢游车队</view><view class="summary-sub">5 位成员 · 3 辆车在线</view></view></view><view class="section-title">成员列表</view><view class="member-list card"><view wx:for="{{members}}" wx:key="id" class="member"><view class="avatar">{{item.avatar}}</view><view class="member-main"><view class="member-name">{{item.name}} <text wx:if="{{item.owner}}">队长</text></view><view class="member-car">{{item.car}}</view></view><view class="online {{item.online ? '' : 'off'}}"></view></view></view></view></view>
